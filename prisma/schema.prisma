generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
  BUYER
}

enum Dimension {
  WEIGHT
  VOLUME
  COUNT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum HazardClass {
  NONE
  FLAMMABLE
  TOXIC
  CORROSIVE
  OXIDIZING
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          Role     @default(BUYER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  orders        Order[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Product {
  id               String      @id @default(cuid())
  name             String
  description      String?
  dimension        Dimension
  baseUnit         String      // e.g., 'g', 'mL', 'count'
  basePrice        Decimal     @db.Decimal(19, 4) // Price per single base unit in INR
  stockQuantity    Decimal     @db.Decimal(19, 6) // Total stock in base units
  
  // MedChem Edge Features
  storageCondition String?     // e.g., 'Ambient', 'Refrigerated 2-8°C'
  hazardClass      HazardClass @default(NONE)
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(19, 4) // Total order price in INR
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id])
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  
  orderedQuantity  Decimal @db.Decimal(19, 6) // The quantity user entered
  orderedUnit      String                     // The unit user selected
  
  baseQuantity     Decimal @db.Decimal(19, 6) // Converted to base unit
  calculatedPrice  Decimal @db.Decimal(19, 4) // Price for this item in INR
}
